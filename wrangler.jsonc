{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stevecampbell",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Custom domain: add stevecampbellassociates.com in the dashboard
  // (Worker → Settings → Domains & Routes) once the domain's DNS is on Cloudflare.
  // Secrets (dashboard or `npx wrangler secret put`): MAILERLITE_API_KEY
  // Optional vars: MAILERLITE_GROUP_EN, MAILERLITE_GROUP_PT
}
